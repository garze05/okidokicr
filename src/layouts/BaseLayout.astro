---
import "aos/dist/aos.css";
import "@styles/global.css";

import { SEO } from "astro-seo";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  includeSitemap?: boolean;
}

const {
  title,
  description = "Empresa de Costa Rica. Ofrecemos Botargas, Fiestas de Cumpleaños, Eventos Familiares y Empresariales con 30 años de Experiencia.",
  bodyClass = "",
  includeSitemap = true,
} = Astro.props;
---

<html lang="es" class="h-full">
  <head>
    <SEO
      title={`OkiDoki - ${title}`}
      description={description}
      openGraph={{
        basic: {
          title: "OkiDoki Fiestas y Eventos Costa Rica",
          type: "website",
          image: "/og.jpg",
        },
      }}
      charset="utf-8"
      extend={{
        link: [{ rel: "icon", href: "/favicon.svg" }],
        meta: [
          {
            name: "viewport",
            content: "width=device-width, initial-scale=1.0",
          },
          { name: "generator", content: Astro.generator },
          {
            name: "keywords",
            content:
              "Botargas, Fiestas de Cumpleaños, Eventos Familiares, Eventos Empresariales, Animación Infantil, OkiDoki",
          },
          { name: "author", content: "Gabriel Rodriguez Ovares" },
        ],
      }}
    />
    {includeSitemap && <link rel="sitemap" href="/sitemap-index.xml" />}
  </head>
  <body class={`h-full ${bodyClass}`}>
    <slot />
    <script>
      import AOS from "aos";
      AOS.init();
    </script>
  </body>
</html>
